# Supabase (new v2 project — Marrs to provide)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# LLM provider — OpenRouter by default (model chosen programmatically via
# OPENROUTER_MODEL; per-agent keys supported). Switch via LLM_PROVIDER:
#   openrouter (default), openai, kimi
LLM_PROVIDER=openrouter

# OpenRouter (default). Pick the base model via OPENROUTER_MODEL, e.g. a DeepSeek
# model for best bang-for-buck. Get a key at https://openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_REFERER=https://polynize.ai
OPENROUTER_TITLE=Polynize Agent Builder

# Agent socket provider (docs/pam-console/agent-socket-contract.md). "interim" =
# the OpenRouter stand-in that satisfies the seam today. "hermes" = the real
# agents: the interview runs console-side in April's name, and jobs go to the
# pull worker. Flip to "hermes" once April's token + the bucket keys are set.
AGENT_PROVIDER=interim

# The console runs April's live interview on her behalf (Option B) and bills it to
# her own OpenRouter key. Falls back to OPENROUTER_API_KEY if unset.
APRIL_OPENROUTER_API_KEY=

# Per-agent bearer token for the pull API (/api/agents/jobs/claim + complete).
# April's box holds the SAME value (as PAM_AGENT_TOKEN) and polls with it; a token
# can only act as its own agent. Generate a strong random secret.
PAM_AGENT_TOKEN_APRIL=

# polynize-agents bucket (Lightsail object storage, ap-southeast-2, private) — the
# agent-shared store for concept docs, brand-voice docs, patterns, and media.
# Until these keys land, concept/brand-voice bodies ride the interim Supabase store
# (same key = the eventual S3 object key, so the swap is config-only).
AGENTS_BUCKET=polynize-agents
AGENTS_BUCKET_REGION=ap-southeast-2
AGENTS_S3_ACCESS_KEY_ID=
AGENTS_S3_SECRET_ACCESS_KEY=

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Kimi / Moonshot (fallback; note: CN-hosted endpoint by default)
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-128k
KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions

# Console auth — magic link via Resend
# CONSOLE_ALLOWED_EMAILS: Polynize team. See all clients.
# CONSOLE_CLIENT_EMAILS:  Per-client access. Format `email:slug,email:slug,...`
#   Each email is scoped to one client slug; signing in redirects them
#   directly to /console/{slug}/blueprint and 404s every other slug.
#   If an email appears in both lists, team scope wins.
POLYNIZE_AUTH_SECRET=
CONSOLE_ALLOWED_EMAILS=marrs@polynize.io,shourov@polynize.io,julian@polynize.io
CONSOLE_CLIENT_EMAILS=
RESEND_ENABLED=true
RESEND_API_KEY=
RESEND_FROM=console@polynize.io

# GitHub App — for Console to read client engagement repos
# GITHUB_APP_PRIVATE_KEY holds multi-line PEM content; when pasting into
# Vercel, either preserve actual newlines or use literal \n sequences (the
# loader normalises both forms before passing to Octokit).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Console agent API key — for the PAM agent to read/write Console state programmatically
# Optional in v1. When set, the PAM agent can authenticate by sending Authorization: Bearer <this value>
CONSOLE_AGENT_API_KEY=

# Scout webhook — when a blueprint is created we POST a payload to Scout's
# endpoint and he handles the actual email send from his polynize.ai address.
# Leave SCOUT_WEBHOOK_URL empty to silently skip dispatch (status logged as
# 'scout_skipped' in email_log). Optional bearer secret on Authorization.
SCOUT_WEBHOOK_URL=
SCOUT_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_COOKIE_NAME=polynize_session
SESSION_COOKIE_MAX_AGE_DAYS=30

# Pricing version stamp on each blueprint
PRICING_VERSION=v1.0-baseline-2026-04

# Soft password gate for /proposals (the index of active client decks +
# proposals). Defaults to 'Agentic444' if unset. Override per-environment
# in Vercel project settings to rotate without a redeploy.
PROPOSALS_PASSWORD=
