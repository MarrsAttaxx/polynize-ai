{
  "name": "polynize-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:css": "node scripts/check-css-modules.mjs",
    "prebuild": "npm run check:css && npm run lint:ci",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:marketing": "npx --yes tsx lib/marketing/__tests__/gate4.test.ts",
    "proof:slides": "npx --yes tsx --tsconfig tsconfig.proof.json scripts/slide-proof.tsx",
    "test:blueprint": "npx --yes tsx lib/blueprint/__tests__/schema-v2.fixture.ts && npx --yes tsx lib/blueprint/__tests__/derive-and-export.test.ts",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --quiet"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@higgsfield/client": "^0.2.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.5.0",
    "gsap": "^3.15.0",
    "image-size": "^1.2.1",
    "jose": "^6.2.3",
    "next": "^15.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.6.0"
  }
}
